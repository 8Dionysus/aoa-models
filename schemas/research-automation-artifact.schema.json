{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aoa.local/models/research-automation-artifact.schema.json",
  "title": "Research automation artifact",
  "oneOf": [
    {"$ref": "#/$defs/capture_snapshot"},
    {"$ref": "#/$defs/change_receipt"},
    {"$ref": "#/$defs/supersession_proposal"}
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "local_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._/-]*$"
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z0-9][a-z0-9._/-]+$"
    },
    "string_list": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pre_canon",
        "automatic_promotion",
        "source_mutation_authority",
        "routing_authority",
        "activation_authority",
        "proof_authority",
        "acceptance_authority"
      ],
      "properties": {
        "pre_canon": {"const": true},
        "automatic_promotion": {"const": false},
        "source_mutation_authority": {"const": false},
        "routing_authority": {"const": false},
        "activation_authority": {"const": false},
        "proof_authority": {"const": false},
        "acceptance_authority": {"const": false}
      }
    },
    "temporal_interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "source_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "title",
        "uri",
        "source_class",
        "publisher",
        "published_at",
        "updated_at",
        "effective_interval",
        "temporal_notes",
        "mutable_surface",
        "origin_group",
        "propagation_role",
        "dependency_refs",
        "access_notes",
        "selection_context"
      ],
      "properties": {
        "source_id": {"$ref": "#/$defs/local_id"},
        "title": {"type": "string", "minLength": 1},
        "uri": {"type": "string", "format": "uri"},
        "source_class": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]*$"
        },
        "publisher": {"type": "string", "minLength": 1},
        "published_at": {"type": ["string", "null"], "format": "date-time"},
        "updated_at": {"type": ["string", "null"], "format": "date-time"},
        "effective_interval": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/temporal_interval"}
          ]
        },
        "temporal_notes": {"type": "string"},
        "mutable_surface": {"type": "boolean"},
        "origin_group": {"type": "string", "minLength": 1},
        "propagation_role": {
          "type": "string",
          "enum": ["origin", "dependent", "mixed", "unresolved"]
        },
        "dependency_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/local_id"}
        },
        "access_notes": {"type": "string"},
        "selection_context": {"type": "string", "minLength": 1}
      }
    },
    "locator": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": {"const": "whole_document"},
            "value": {"type": "null"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": {"const": "line_range"},
            "value": {
              "type": "object",
              "additionalProperties": false,
              "required": ["start", "end"],
              "properties": {
                "start": {"type": "integer", "minimum": 1},
                "end": {"type": "integer", "minimum": 1}
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": {"const": "json_pointer"},
            "value": {"type": "string", "pattern": "^(|/.*)$"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": {"const": "html_id"},
            "value": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "capture_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "source", "segment", "retrieval"],
      "properties": {
        "schema_version": {"const": "aoa_model_research_capture_request_v1"},
        "source": {"$ref": "#/$defs/source_metadata"},
        "segment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["segment_id", "locator"],
          "properties": {
            "segment_id": {"$ref": "#/$defs/local_id"},
            "locator": {"$ref": "#/$defs/locator"}
          }
        },
        "retrieval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["media_type", "max_bytes", "timeout_seconds"],
          "properties": {
            "media_type": {
              "type": "string",
              "pattern": "^(auto|[a-z0-9.+-]+/[a-z0-9.+-]+)$"
            },
            "max_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16777216
            },
            "timeout_seconds": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 120
            }
          }
        }
      }
    },
    "retrieval_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "transport",
        "attempted_at",
        "input_ref",
        "final_uri",
        "media_type",
        "http_status",
        "etag",
        "last_modified",
        "document_digest",
        "document_size_bytes",
        "truncated",
        "error"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["captured", "partial", "unavailable"]
        },
        "transport": {
          "type": "string",
          "enum": ["http", "local_input"]
        },
        "attempted_at": {"type": "string", "format": "date-time"},
        "input_ref": {"type": ["string", "null"], "minLength": 1},
        "final_uri": {"type": ["string", "null"], "format": "uri"},
        "media_type": {"type": ["string", "null"], "minLength": 1},
        "http_status": {"type": ["integer", "null"], "minimum": 100, "maximum": 599},
        "etag": {"type": ["string", "null"], "minLength": 1},
        "last_modified": {"type": ["string", "null"], "minLength": 1},
        "document_digest": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]
        },
        "document_size_bytes": {"type": ["integer", "null"], "minimum": 0},
        "truncated": {"type": "boolean"},
        "error": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "segment_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "content_digest",
        "normalized_content_digest",
        "byte_length",
        "normalization_profile",
        "digest_unavailable_reason"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["captured", "partial", "missing", "unavailable"]
        },
        "content_digest": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]
        },
        "normalized_content_digest": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]
        },
        "byte_length": {"type": ["integer", "null"], "minimum": 0},
        "normalization_profile": {"type": ["string", "null"], "minLength": 1},
        "digest_unavailable_reason": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "ref", "content_digest"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/artifact_id"},
        "ref": {"type": "string", "minLength": 1},
        "content_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "capture_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$schema",
        "schema_version",
        "kind",
        "capture_id",
        "created_at",
        "authority",
        "promotion_policy",
        "request",
        "retrieval",
        "segment_result",
        "source_capture_candidate",
        "predecessor_snapshot",
        "gap_reasons",
        "artifact_digest"
      ],
      "properties": {
        "$schema": {
          "const": "https://schemas.aoa.local/models/research-automation-artifact.schema.json"
        },
        "schema_version": {"const": "aoa_model_research_automation_artifact_v1"},
        "kind": {"const": "ResearchCaptureSnapshot"},
        "capture_id": {
          "type": "string",
          "pattern": "^research-capture:[a-z0-9][a-z0-9._/-]+$"
        },
        "created_at": {"type": "string", "format": "date-time"},
        "authority": {"$ref": "#/$defs/authority"},
        "promotion_policy": {"const": "pre_canon_no_automatic_promotion"},
        "request": {"$ref": "#/$defs/capture_request"},
        "retrieval": {"$ref": "#/$defs/retrieval_result"},
        "segment_result": {"$ref": "#/$defs/segment_result"},
        "source_capture_candidate": {
          "$ref": "https://schemas.aoa.local/models/recon-run.schema.json#/$defs/source_capture"
        },
        "predecessor_snapshot": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/artifact_ref"}]
        },
        "gap_reasons": {"$ref": "#/$defs/string_list"},
        "artifact_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "change_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retrieval_state_changed",
        "document_digest_changed",
        "segment_state_changed",
        "segment_digest_changed",
        "normalized_segment_digest_changed"
      ],
      "properties": {
        "retrieval_state_changed": {"type": "boolean"},
        "document_digest_changed": {"type": ["boolean", "null"]},
        "segment_state_changed": {"type": "boolean"},
        "segment_digest_changed": {"type": ["boolean", "null"]},
        "normalized_segment_digest_changed": {"type": ["boolean", "null"]}
      }
    },
    "change_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$schema",
        "schema_version",
        "kind",
        "receipt_id",
        "created_at",
        "authority",
        "previous_snapshot",
        "current_snapshot",
        "classification",
        "basis",
        "review_disposition",
        "automatic_supersession",
        "artifact_digest"
      ],
      "properties": {
        "$schema": {
          "const": "https://schemas.aoa.local/models/research-automation-artifact.schema.json"
        },
        "schema_version": {"const": "aoa_model_research_automation_artifact_v1"},
        "kind": {"const": "ResearchChangeReceipt"},
        "receipt_id": {
          "type": "string",
          "pattern": "^research-change:[a-z0-9][a-z0-9._/-]+$"
        },
        "created_at": {"type": "string", "format": "date-time"},
        "authority": {"$ref": "#/$defs/authority"},
        "previous_snapshot": {"$ref": "#/$defs/artifact_ref"},
        "current_snapshot": {"$ref": "#/$defs/artifact_ref"},
        "classification": {
          "type": "string",
          "enum": [
            "unchanged",
            "document_changed_segment_stable",
            "presentation_changed",
            "content_changed",
            "segment_became_missing",
            "segment_restored",
            "source_unavailable",
            "source_recovered",
            "unavailable_persists",
            "incomparable"
          ]
        },
        "basis": {"$ref": "#/$defs/change_basis"},
        "review_disposition": {
          "type": "string",
          "enum": ["no_change", "review_optional", "review_required", "retry_or_revisit"]
        },
        "automatic_supersession": {"const": false},
        "artifact_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "qualified_observation_artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recon_run_id",
        "recon_run_ref",
        "recon_run_digest",
        "observation_id",
        "observation_digest",
        "target_kind",
        "observed_interval",
        "source_segment_refs",
        "counterevidence_refs"
      ],
      "properties": {
        "recon_run_id": {
          "type": "string",
          "pattern": "^recon-run:[a-z0-9][a-z0-9._/-]+$"
        },
        "recon_run_ref": {
          "type": "string",
          "pattern": "^research-intake/recon-runs/[a-z0-9][a-z0-9._-]*\\.json$"
        },
        "recon_run_digest": {"$ref": "#/$defs/digest"},
        "observation_id": {"$ref": "#/$defs/local_id"},
        "observation_digest": {"$ref": "#/$defs/digest"},
        "target_kind": {"type": "string", "minLength": 1},
        "observed_interval": {"$ref": "#/$defs/temporal_interval"},
        "source_segment_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_id", "segment_id"],
            "properties": {
              "source_id": {"$ref": "#/$defs/local_id"},
              "segment_id": {"$ref": "#/$defs/local_id"}
            }
          }
        },
        "counterevidence_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/local_id"}
        }
      }
    },
    "structural_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "same_target_kind",
        "shared_subject_dimensions",
        "conflicting_subject_dimensions",
        "shared_configuration_dimensions",
        "conflicting_configuration_dimensions",
        "temporal_relation"
      ],
      "properties": {
        "same_target_kind": {"type": "boolean"},
        "shared_subject_dimensions": {"$ref": "#/$defs/string_list"},
        "conflicting_subject_dimensions": {"$ref": "#/$defs/string_list"},
        "shared_configuration_dimensions": {"$ref": "#/$defs/string_list"},
        "conflicting_configuration_dimensions": {"$ref": "#/$defs/string_list"},
        "temporal_relation": {
          "type": "string",
          "enum": ["after", "overlap", "before", "unknown"]
        }
      }
    },
    "supersession_proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$schema",
        "schema_version",
        "kind",
        "proposal_id",
        "created_at",
        "status",
        "authority",
        "prior_observation",
        "candidate_observation",
        "candidate_relation",
        "scope_dimensions",
        "rationale",
        "ambiguities",
        "structural_comparison",
        "candidate_action",
        "review_required",
        "automatic_application",
        "mutation_policy",
        "artifact_digest"
      ],
      "properties": {
        "$schema": {
          "const": "https://schemas.aoa.local/models/research-automation-artifact.schema.json"
        },
        "schema_version": {"const": "aoa_model_research_automation_artifact_v1"},
        "kind": {"const": "ResearchSupersessionProposal"},
        "proposal_id": {
          "type": "string",
          "pattern": "^research-supersession:[a-z0-9][a-z0-9._/-]+$"
        },
        "created_at": {"type": "string", "format": "date-time"},
        "status": {"const": "proposed"},
        "authority": {"$ref": "#/$defs/authority"},
        "prior_observation": {"$ref": "#/$defs/qualified_observation_artifact_ref"},
        "candidate_observation": {"$ref": "#/$defs/qualified_observation_artifact_ref"},
        "candidate_relation": {
          "type": "string",
          "enum": ["update", "narrowing", "contradiction", "independent"]
        },
        "scope_dimensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "rationale": {"type": "string", "minLength": 20},
        "ambiguities": {"$ref": "#/$defs/string_list"},
        "structural_comparison": {"$ref": "#/$defs/structural_comparison"},
        "candidate_action": {
          "type": "string",
          "enum": [
            "review_add_qualified_supersedes_ref",
            "review_as_tension",
            "preserve_independent"
          ]
        },
        "review_required": {"const": true},
        "automatic_application": {"const": false},
        "mutation_policy": {"const": "no_source_or_recon_run_mutation"},
        "artifact_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
