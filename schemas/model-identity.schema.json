{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aoa.local/models/model-identity.schema.json",
  "title": "ModelIdentity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "kind",
    "model_identity_id",
    "provider",
    "family",
    "variant",
    "version",
    "snapshot",
    "aliases",
    "status",
    "source_refs",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "$schema": {
      "const": "https://schemas.aoa.local/models/model-identity.schema.json"
    },
    "schema_version": {
      "const": "aoa_model_identity_v1"
    },
    "kind": {
      "const": "ModelIdentity"
    },
    "model_identity_id": {
      "type": "string",
      "pattern": "^model-identity:[a-z0-9][a-z0-9._/-]+$"
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "family": {
      "type": "string",
      "minLength": 1
    },
    "variant": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "snapshot": {
      "type": ["string", "null"]
    },
    "aliases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "type": "string",
      "enum": ["active", "deprecated", "retired"]
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://schemas.aoa.local/models/common.schema.json#/$defs/source_ref"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
