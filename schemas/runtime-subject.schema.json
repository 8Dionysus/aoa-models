{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aoa.local/models/runtime-subject.schema.json",
  "title": "Exact immutable runtime subject identity",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "source", "digest"],
  "properties": {
    "kind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]*$"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
