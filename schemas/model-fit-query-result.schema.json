{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aoa.local/models/model-fit-query-result.schema.json",
  "title": "Read-only model fit query result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "query",
    "candidate_count",
    "candidates",
    "authority",
    "source_root"
  ],
  "properties": {
    "schema_version": {"const": "aoa_model_fit_query_result_v1"},
    "query": {"$ref": "https://schemas.aoa.local/models/model-fit-query.schema.json"},
    "candidate_count": {"type": "integer", "minimum": 0},
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "realization_ref",
          "projection_ref",
          "model_slug",
          "reasoning_effort",
          "sandbox_mode",
          "lifecycle_state",
          "projection_posture",
          "freshness",
          "task_fit",
          "limitations"
        ],
        "properties": {
          "realization_ref": {"type": "string", "minLength": 1},
          "projection_ref": {"type": "string", "minLength": 1},
          "model_slug": {"type": "string", "minLength": 1},
          "reasoning_effort": {"type": "string", "minLength": 1},
          "sandbox_mode": {"type": "string", "minLength": 1},
          "lifecycle_state": {"enum": ["declared", "observed"]},
          "projection_posture": {"type": "string", "minLength": 1},
          "freshness": {"enum": ["current", "unknown"]},
          "task_fit": {"type": "array", "minItems": 1},
          "limitations": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "informational_only",
        "activation_authority",
        "routing_authority",
        "proof_authority",
        "acceptance_authority"
      ],
      "properties": {
        "informational_only": {"const": true},
        "activation_authority": {"const": false},
        "routing_authority": {"const": false},
        "proof_authority": {"const": false},
        "acceptance_authority": {"const": false}
      }
    },
    "source_root": {"type": "string", "pattern": "^/"}
  }
}
