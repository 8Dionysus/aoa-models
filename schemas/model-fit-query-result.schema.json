{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aoa.local/models/model-fit-query-result.schema.json",
  "title": "Content-addressed read-only model fit query result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_id",
    "query_digest",
    "query",
    "candidate_count",
    "candidates",
    "authority",
    "owner_source_ref",
    "catalog_digest",
    "result_digest"
  ],
  "properties": {
    "schema_version": {"const": "aoa_model_fit_query_result_v2"},
    "result_id": {
      "type": "string",
      "pattern": "^model-fit-query-result:[0-9a-f]{32}$"
    },
    "query_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "query": {"$ref": "https://schemas.aoa.local/models/model-fit-query.schema.json"},
    "candidate_count": {"type": "integer", "minimum": 0},
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "realization_ref",
          "projection_ref",
          "realization_provenance",
          "projection_provenance",
          "fit_evidence_refs",
          "model_slug",
          "reasoning_effort",
          "sandbox_mode",
          "lifecycle_state",
          "projection_posture",
          "freshness",
          "task_fit",
          "limitations"
        ],
        "properties": {
          "realization_ref": {"type": "string", "minLength": 1},
          "projection_ref": {"type": "string", "minLength": 1},
          "runtime_subject": {
            "$ref": "https://schemas.aoa.local/models/runtime-subject.schema.json"
          },
          "realization_provenance": {"$ref": "#/$defs/provenanceRef"},
          "projection_provenance": {"$ref": "#/$defs/provenanceRef"},
          "fit_evidence_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/provenanceRef"}
          },
          "model_slug": {"type": "string", "minLength": 1},
          "reasoning_effort": {"type": "string", "minLength": 1},
          "sandbox_mode": {"type": "string", "minLength": 1},
          "lifecycle_state": {"enum": ["declared", "observed"]},
          "projection_posture": {"type": "string", "minLength": 1},
          "freshness": {"enum": ["current", "unknown"]},
          "task_fit": {"type": "array", "minItems": 1},
          "limitations": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "informational_only",
        "activation_authority",
        "routing_authority",
        "proof_authority",
        "acceptance_authority"
      ],
      "properties": {
        "informational_only": {"const": true},
        "activation_authority": {"const": false},
        "routing_authority": {"const": false},
        "proof_authority": {"const": false},
        "acceptance_authority": {"const": false}
      }
    },
    "owner_source_ref": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "catalog_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "result_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "provenanceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_repo",
        "artifact_ref",
        "source_ref",
        "artifact_digest",
        "schema_ref",
        "schema_version"
      ],
      "properties": {
        "owner_repo": {"const": "aoa-models"},
        "artifact_ref": {
          "type": "string",
          "pattern": "^(source|generated)/[A-Za-z0-9._/-]+\\.json$"
        },
        "source_ref": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "artifact_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "schema_ref": {"type": "string", "pattern": "^schemas/[A-Za-z0-9._/-]+\\.json$"},
        "schema_version": {
          "enum": [
            "aoa_model_realization_v1",
            "aoa_model_fit_projection_v1",
            "aoa_model_claim_v1",
            "aoa_model_study_v1"
          ]
        }
      }
    }
  }
}
