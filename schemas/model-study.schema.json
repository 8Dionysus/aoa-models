{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aoa.local/models/model-study.schema.json",
  "title": "ModelStudy",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {"schema_version": {"const": "aoa_model_study_v2"}},
        "required": ["schema_version"]
      },
      "then": {
        "properties": {
          "protocol": {
            "required": ["task_routes", "trial_order", "writer_reviewer_separation", "wake_policy", "usage_metering"]
          }
        }
      }
    }
  ],
  "required": [
    "$schema",
    "schema_version",
    "kind",
    "model_study_id",
    "title",
    "status",
    "definition_owner",
    "proof_owner",
    "question",
    "protocol",
    "fixed_inputs",
    "comparison_arms",
    "metrics",
    "result_refs",
    "attribution_limits",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "$schema": {"const": "https://schemas.aoa.local/models/model-study.schema.json"},
    "schema_version": {"enum": ["aoa_model_study_v1", "aoa_model_study_v2"]},
    "kind": {"const": "ModelStudy"},
    "model_study_id": {
      "type": "string",
      "pattern": "^model-study:[a-z0-9][a-z0-9._/-]+$"
    },
    "title": {"type": "string", "minLength": 1},
    "status": {
      "type": "string",
      "enum": ["designed", "fixed", "running", "completed", "reviewed", "abandoned"]
    },
    "definition_owner": {"const": "aoa-models"},
    "proof_owner": {"const": "aoa-evals"},
    "question": {"type": "string", "minLength": 20},
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_routes", "trial_order", "writer_reviewer_separation", "wake_policy"],
      "properties": {
        "task_routes": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "trial_order": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "writer_reviewer_separation": {"type": "boolean"},
        "wake_policy": {"type": "string", "minLength": 1},
        "usage_metering": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "execution_limit_policy", "metering_regime", "dimensions", "cost_interpretation"],
          "properties": {
            "mode": {"const": "observe_only"},
            "execution_limit_policy": {"const": "none"},
            "metering_regime": {"type": "string", "minLength": 1},
            "dimensions": {
              "type": "array",
              "minItems": 7,
              "maxItems": 7,
              "uniqueItems": true,
              "items": {
                "enum": ["input_tokens", "cached_input_tokens", "output_tokens", "active_wall_seconds", "turn_count", "output_bytes", "executed_commands"]
              }
            },
            "cost_interpretation": {"const": "measurement_owner"}
          }
        }
      }
    },
    "fixed_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fixture_ref", "sha256", "immutable_invariants"],
        "properties": {
          "fixture_ref": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "immutable_invariants": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "comparison_arms": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["arm_id", "realization_refs", "route"],
        "properties": {
          "arm_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "realization_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^source/model-realizations/[a-z0-9][a-z0-9._-]*\\.json$"
            }
          },
          "route": {"type": "string", "minLength": 1}
        }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "result_refs": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.aoa.local/models/common.schema.json#/$defs/source_ref"
      }
    },
    "attribution_limits": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
