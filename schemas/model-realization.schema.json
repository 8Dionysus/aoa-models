{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aoa.local/models/model-realization.schema.json",
  "title": "ModelRealization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "kind",
    "model_realization_id",
    "model_identity_ref",
    "configuration",
    "configuration_fingerprint",
    "observation_interval",
    "lifecycle_state",
    "source_refs",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "$schema": {
      "const": "https://schemas.aoa.local/models/model-realization.schema.json"
    },
    "schema_version": {
      "const": "aoa_model_realization_v1"
    },
    "kind": {
      "const": "ModelRealization"
    },
    "model_realization_id": {
      "type": "string",
      "pattern": "^model-realization:[a-z0-9][a-z0-9._/-]+$"
    },
    "model_identity_ref": {
      "type": "string",
      "pattern": "^source/model-identities/[a-z0-9][a-z0-9._-]*\\.json$"
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "access",
        "runtime",
        "reasoning_effort",
        "context",
        "tools",
        "environment",
        "permissions",
        "economics"
      ],
      "properties": {
        "access": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "surface",
            "auth_regime",
            "billing_regime",
            "supported_in_api"
          ],
          "properties": {
            "provider": {"type": "string", "minLength": 1},
            "surface": {"type": "string", "minLength": 1},
            "auth_regime": {
              "type": "string",
              "enum": ["api_key", "chatgpt_login", "enterprise", "local", "other"]
            },
            "billing_regime": {
              "type": "string",
              "enum": [
                "standard_api",
                "batch_api",
                "chatgpt_quota",
                "enterprise_contract",
                "local_compute",
                "other"
              ]
            },
            "supported_in_api": {"type": "boolean"}
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "product",
            "version",
            "executable",
            "model_slug",
            "transport",
            "multi_agent_backend_version",
            "resume_surface"
          ],
          "properties": {
            "product": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "executable": {"type": "string", "minLength": 1},
            "model_slug": {"type": "string", "minLength": 1},
            "transport": {
              "type": "string",
              "enum": ["exec-jsonl", "app-server", "other"]
            },
            "multi_agent_backend_version": {
              "type": ["string", "null"]
            },
            "resume_surface": {"type": "string", "minLength": 1}
          }
        },
        "reasoning_effort": {
          "type": "string",
          "enum": ["low", "medium", "high", "xhigh", "max"]
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nominal_context_tokens",
            "effective_context_percent",
            "regime"
          ],
          "properties": {
            "nominal_context_tokens": {"type": "integer", "minimum": 1},
            "effective_context_percent": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "regime": {"type": "string", "minLength": 1}
          }
        },
        "tools": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile_mode",
            "profile_ref",
            "required_tools",
            "required_mcp_servers",
            "inheritance_allowed"
          ],
          "properties": {
            "profile_mode": {
              "type": "string",
              "enum": ["explicit", "runtime_profile_ref"]
            },
            "profile_ref": {"type": "string", "minLength": 1},
            "required_tools": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "required_mcp_servers": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "inheritance_allowed": {"type": "boolean"}
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role_profile_ref",
            "prompt_contract_ref",
            "cwd_policy",
            "instruction_policy",
            "locale"
          ],
          "properties": {
            "role_profile_ref": {"type": "string", "minLength": 1},
            "prompt_contract_ref": {"type": "string", "minLength": 1},
            "cwd_policy": {
              "type": "string",
              "enum": ["isolated-ref", "dedicated-worktree", "read-only-source"]
            },
            "instruction_policy": {"type": "string", "minLength": 1},
            "locale": {"type": "string", "minLength": 2}
          }
        },
        "permissions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sandbox_mode",
            "approval_policy",
            "external_effects",
            "network_access"
          ],
          "properties": {
            "sandbox_mode": {
              "type": "string",
              "enum": ["read-only", "workspace-write", "danger-full-access"]
            },
            "approval_policy": {
              "type": "string",
              "enum": ["never", "on-request", "on-failure", "untrusted"]
            },
            "external_effects": {"type": "boolean"},
            "network_access": {
              "type": "string",
              "enum": ["disabled", "allowlisted", "enabled"]
            }
          }
        },
        "economics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["active_regime", "meter", "reference_prices"],
          "properties": {
            "active_regime": {"type": "string", "minLength": 1},
            "meter": {"type": "string", "minLength": 1},
            "reference_prices": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "regime",
                  "currency",
                  "unit",
                  "not_active_for_this_realization",
                  "effective_at",
                  "prices",
                  "source_uri"
                ],
                "properties": {
                  "regime": {"type": "string", "minLength": 1},
                  "currency": {"const": "USD"},
                  "unit": {"const": "per_1m_tokens"},
                  "not_active_for_this_realization": {"type": "boolean"},
                  "effective_at": {"type": "string", "format": "date-time"},
                  "prices": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["input", "cached_input", "cache_write", "output"],
                    "properties": {
                      "input": {"type": "number", "minimum": 0},
                      "cached_input": {"type": "number", "minimum": 0},
                      "cache_write": {"type": "number", "minimum": 0},
                      "output": {"type": "number", "minimum": 0}
                    }
                  },
                  "source_uri": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        }
      }
    },
    "configuration_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "observation_interval": {
      "$ref": "https://schemas.aoa.local/models/common.schema.json#/$defs/observation_interval"
    },
    "lifecycle_state": {
      "type": "string",
      "enum": ["declared", "observed", "suspended", "stale", "retired"]
    },
    "source_refs": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "https://schemas.aoa.local/models/common.schema.json#/$defs/source_ref"
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
